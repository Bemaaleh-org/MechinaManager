# ============================================================
#   סופי שורה — למה זה כאן
# ------------------------------------------------------------
# ⚠⚠ גיט בווינדוס ממיר קבצים ל-CRLF בצ׳קאאוט (core.autocrlf).
#    סקריפטי ה-seed כותבים מחדש את shared/*-ids.js בביטוי רגולרי
#    שחיפש `;\n`, וב-CRLF הוא לא תפס כלום — ואז כל החלפה **הוסיפה**
#    הצהרה שנייה במקום להחליף. שתי הצהרות export לאותו שם הן
#    SyntaxError, כלומר api/students.js מפסיק להיטען לגמרי
#    וכל מסך במערכת מחזיר 500.
#
#    הביטוי תוקן ל-`;\r?\n` והוא גם מוחק כפילויות, אבל LF כפוי
#    הוא מה שמונע את כל המשפחה הזו מלכתחילה. קוד שנכתב ונקרא
#    על ידי סקריפטים צריך סוף שורה אחד בשתי מערכות ההפעלה.
# ============================================================

*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# ⚠ אלה דווקא CRLF. cmd.exe **דורש** CRLF — קובץ .cmd עם LF
#   נכשל בשקט או מריץ שורה חלקית. ל-PowerShell זה פחות קריטי,
#   ועדיין: שני הקבצים נפתחים בעורכי ווינדוס.
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ⚠ בינאריים — שלא ייגע בהם בכלל.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.xlsx binary
