# תבנית לדוגמה — הקובץ הזה כן נכנס ל-git, בלי ערכים אמיתיים.
# מי שמקים את הפרויקט מחדש מעתיק אותו ל-.env וממלא את הטוקן.

MONDAY_TOKEN=
MONDAY_BOARD_CATALOG=5101009573
MONDAY_BOARD_MOVES=5101009681
MONDAY_BOARD_LISTS=5101009698

# מפתח לחתימת עוגיית הסשן. לפחות 32 תווים.
# ייצור: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# שינוי שלו מנתק את כל המשתמשים המחוברים.
SESSION_SECRET=

# ------------------------------------------------------------
# שליחת דואר — אופציונלי
# ------------------------------------------------------------
# ⚠ בלי המפתחות האלה המערכת עובדת במלואה. איפוס סיסמה פשוט
#   הופך לקוד בן שש ספרות שהמנהל מוסר פנים אל פנים, ואת הקוד
#   הוא רואה בעמודת "איפוס סיסמה" בלוח.
#
# ⚠ שני השדות נדרשים יחד. אחד בלי השני = אין שליחה.
# ⚠ MAIL_FROM חייב להיות כתובת בדומיין מאומת אצל Resend.
RESEND_API_KEY=
MAIL_FROM=
