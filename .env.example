# תבנית לדוגמה — הקובץ הזה כן נכנס ל-git, בלי ערכים אמיתיים.
# מי שמקים את הפרויקט מחדש מעתיק אותו ל-.env וממלא את הטוקן.

MONDAY_TOKEN=
MONDAY_BOARD_CATALOG=5101009573
MONDAY_BOARD_MOVES=5101009681
MONDAY_BOARD_LISTS=5101009698

# מפתח לחתימת עוגיית הסשן. לפחות 32 תווים.
# ייצור: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# שינוי שלו מנתק את כל המשתמשים המחוברים.
SESSION_SECRET=

# ------------------------------------------------------------
# שליחת דואר — אופציונלי
# ------------------------------------------------------------
# ⚠ בלי כלום מזה המערכת עובדת במלואה. איפוס סיסמה פשוט הופך
#   לקוד בן שש ספרות שהמנהל רואה בפעמון ההתראות ומוסר ביד.
#
# יש שני מסלולים, ו-SMTP גובר אם שניהם מוגדרים.

# ---- מסלול 1: Google Workspace (המומלץ למכינה) ----
# ⚠ המכינה כבר על Workspace — ה-MX של bemaaleh.com מצביע ל-
#   smtp.google.com. אין צורך לאמת שום דומיין ואין נגיעה ב-DNS.
#
# SMTP_PASS הוא **סיסמת אפליקציה** בת 16 תווים
# (myaccount.google.com/apppasswords), ולא הסיסמה של החשבון.
# ⚠ דורש ש-2-Step Verification יהיה מופעל על אותו חשבון.
# ⚠ MAIL_FROM חייב להיות אותה כתובת של SMTP_USER, או כינוי מאושר שלה.
SMTP_USER=
SMTP_PASS=

# ---- מסלול 2: Resend ----
# ⚠ דורש אימות דומיין, והאימות דורש רשומת MX על תת-דומיין —
#   מה ש-Wix אינה תומכת בו. לא רלוונטי לבמעלה כל עוד ה-DNS שם.
RESEND_API_KEY=

# משותף לשני המסלולים
MAIL_FROM=
